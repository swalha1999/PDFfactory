{
  "version": "1.00",
  "language": "en",
  "bidi_chapter_language": "he",
  "target_pages": 15,
  "compiler": "lualatex",
  "compile_passes": 4,
  "bib_backend": "bibtex",
  "document_class": "article",
  "search_provider": "serper",
  "llm_provider": "anthropic",
  "worker_model": "anthropic/claude-haiku-4-5",
  "engineer_model": "anthropic/claude-sonnet-4-6",
  "worker_max_tokens": 16000,
  "engineer_max_tokens": 32000,
  "human_in_the_loop": false,
  "results_dir": "results",
  "validator": {
    "page_count_tolerance": 3,
    "overfull_hbox_threshold_pt": 10,
    "max_remediation_rounds": 2
  },
  "latex": {
    "hebrew_font": "Arial Hebrew",
    "font_size": "12pt",
    "margin_cm": 2.5
  },
  "sandbox": {
    "backend": "subprocess_isolated",
    "timeout_s": 60,
    "max_output_mb": 10,
    "allowed_imports": ["matplotlib", "numpy", "math", "random"]
  },
  "cover": {
    "author": "Muhammad Swalha and Mohammed Abad",
    "course": "Mass Production of AI Agents",
    "lecturer": "Dr. Yoram Segal"
  }
}
