# AgentScribe — environment variables
# -------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values.
# NEVER commit `.env` — it holds secrets. Only this `.env-example` is committed.
#   macOS/Linux:  cp .env-example .env
#   PowerShell:   Copy-Item .env-example .env
# -------------------------------------------------------------------

# === LLM provider: Anthropic (Claude) ============================
# Required. The CrewAI / LiteLLM layer reads this automatically.
# Get a key at https://console.anthropic.com -> Settings -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# (Alternative provider — only if config/setup.json selects openai/* models.)
# OPENAI_API_KEY=sk-your-openai-key-here

# === Web search tool (research agent) ============================
# Required for FR-2 (research). CrewAI's SerperDevTool reads this.
# Free tier (2,500 queries) at https://serper.dev
SERPER_API_KEY=your-serper-key-here

# === Model selection (OPTIONAL — overrides config/setup.json) =====
# Models are normally chosen in config/setup.json (no hard-coding), but
# you may override them here. Use LiteLLM strings: "anthropic/<model-id>".
#   Worker agents (researcher/writer/editor) — cheaper/faster:
# AGENTSCRIBE_WORKER_MODEL=anthropic/claude-haiku-4-5
#   LaTeX engineer / editor escalation — strongest for correct markup:
# AGENTSCRIBE_ENGINEER_MODEL=anthropic/claude-sonnet-4-6

# === Misc (OPTIONAL) =============================================
# Telemetry off (CrewAI phones home by default; keep grading offline).
CREWAI_TELEMETRY_OPT_OUT=true
# LiteLLM logging level: DEBUG | INFO | WARNING | ERROR
# LITELLM_LOG=WARNING
